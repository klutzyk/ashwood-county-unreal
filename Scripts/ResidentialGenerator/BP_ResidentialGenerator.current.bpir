    %n4: double = call BreakVector(InVec: %n2.Size_6_A050281547D25A85B4448B81EF60035D) @(528, 240)
    %n5: double = call Add_DoubleDouble(A: %n3.X, B: %n4.X) @(720, 72)
    %n6: bool = call Less_DoubleDouble(A: %n1.X, B: %n5) @(864, 56)
    %n7: double = call BreakVector(InVec: %n0.Size_6_A050281547D25A85B4448B81EF60035D) @(528, 608)
    %n8: double = call Add_DoubleDouble(A: %n1.X, B: %n7.X) @(720, 192)
    %n9: bool = call Less_DoubleDouble(A: %n3.X, B: %n8) @(864, 176)
