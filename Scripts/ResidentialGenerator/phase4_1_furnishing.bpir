entry function SelectFurnitureTheme() {
    %seed = call Add_IntInt(A: $Seed, B: $FurnitureSeedOffset)
    %stream = call MakeRandomStream(InitialSeed: %seed)
    set FurnitureStream = %stream
    %theme = call RandomIntegerInRangeFromStream(Stream: $FurnitureStream, Min: 0, Max: 1)
    set FurnitureTheme = %theme
    return
}

entry function PlaceThemedSofa(float X, float Y, float Yaw) {
    %classic = call EqualEqual_IntInt(A: $FurnitureTheme, B: 1)
    branch(%classic) [true -> @classicStyle, false -> @modernStyle]
@classicStyle:
    %classicYaw = call Subtract_DoubleDouble(A: $Yaw, B: 90)
    call Place(Component: $Furniture_SofaClassic, X: $X, Y: $Y, Z: 0, Yaw: %classicYaw, SX: 1, SY: 1, SZ: 1)
    return
@modernStyle:
    call Place(Component: $Furniture_Sofa, X: $X, Y: $Y, Z: 0, Yaw: $Yaw, SX: 1, SY: 1, SZ: 1)
    return
}

entry function PlaceThemedArmchair(float X, float Y, float Yaw) {
    %classic = call EqualEqual_IntInt(A: $FurnitureTheme, B: 1)
    branch(%classic) [true -> @classicStyle, false -> @modernStyle]
@classicStyle:
    call Place(Component: $Furniture_ArmchairClassic, X: $X, Y: $Y, Z: 0, Yaw: $Yaw, SX: 1, SY: 1, SZ: 1)
    return
@modernStyle:
    call Place(Component: $Furniture_Armchair, X: $X, Y: $Y, Z: 0, Yaw: $Yaw, SX: 1, SY: 1, SZ: 1)
    return
}

