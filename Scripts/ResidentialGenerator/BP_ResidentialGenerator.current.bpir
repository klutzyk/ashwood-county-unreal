@meta(Category="House Generator")
@flags(Public, CallInEditor)
entry function RegenerateBuilding() @(0, 0) {
    call BeginTransaction(Context: "ResidentialGenerator", Description: "NSLOCTEXT(\"AshwoodHousing\", \"Regenerate\", \"Regenerate residential building\")", PrimaryObject: self) @(432, 0)
    call TransactObject(Object: self) @(984, 0)
    call BuildPlan() @(1224, -16)
    %n0 = branch($LayoutValid) [false -> @merge, true -> @then] @(1744, 0)

@then:
    call ClearGeometry() @(2000, -16)
    call SetMaterial(Target: $Floor, ElementIndex: 1, Material: $FloorMaterial) @(2528, -16)
    call SetMaterial(Target: $Exterior, ElementIndex: 1, Material: $ExteriorMaterial) @(3048, -16)
    call SetMaterial(Target: $Entrance, ElementIndex: 1, Material: $ExteriorMaterial) @(3544, -16)
    call SetMaterial(Target: $Window, ElementIndex: 1, Material: $ExteriorMaterial) @(4040, -16)
    call SetMaterial(Target: $Corner, ElementIndex: 1, Material: $ExteriorMaterial) @(4536, -16)
    call SetVisibility(Target: $RoofPanel, bNewVisibility: true, bPropagateToChildren: false) @(5032, -16)
    call SetVisibility(Target: $RoofCorner, bNewVisibility: true, bPropagateToChildren: false) @(5584, -16)
    call SetVisibility(Target: $Ceiling, bNewVisibility: true, bPropagateToChildren: false) @(6136, -16)
    call BuildFloors() @(6496, -16)
    call BuildShell() @(6824, -16)
    call BuildRoof() @(7152, -16)
    %n1: string = call Conv_IntToString(InInt: $RoomCount) @(7672, 108)
    %n2: string = call Concat_StrStr(A: "Generated rooms (excluding hallway): ", B: %n1) @(7816, 56)
    set GenerationStatus = %n2 @(8256, 0)
    exec -> @merge

@merge:
    call EndTransaction() @(8592, 0)
    return @(8880, 0)
}

