entry function PlanCabinRooms() {
    call Array_Clear(TargetArray: $GeneratedRooms)
    %layout = switch_int($LayoutVariant) [2 -> @square, 3 -> @large, default -> @done]
@square:
    call AddCabinRoom(Kind: "LivingKitchen", MinX: -380, MinY: -380, MaxX: 380, MaxY: 100, DoorX: 0, DoorY: -400)
    call AddCabinRoom(Kind: "Bedroom", MinX: -380, MinY: 100, MaxX: 0, MaxY: 380, DoorX: -300, DoorY: 100)
    call AddCabinRoom(Kind: "BathroomUtility", MinX: 0, MinY: 100, MaxX: 380, MaxY: 380, DoorX: 100, DoorY: 100)
    return
@large:
    call AddCabinRoom(Kind: "Living", MinX: -380, MinY: -580, MaxX: 380, MaxY: -100, DoorX: 0, DoorY: -600)
    call AddCabinRoom(Kind: "KitchenDining", MinX: -380, MinY: -100, MaxX: 380, MaxY: 250, DoorX: -100, DoorY: -100)
    call AddCabinRoom(Kind: "Bedroom1", MinX: -380, MinY: 250, MaxX: 0, MaxY: 580, DoorX: -100, DoorY: 250)
    call AddCabinRoom(Kind: "Bedroom2", MinX: 0, MinY: 250, MaxX: 380, MaxY: 580, DoorX: 300, DoorY: 250)
    call AddCabinRoom(Kind: "BathroomUtility", MinX: 100, MinY: -100, MaxX: 380, MaxY: 100, DoorX: 100, DoorY: 0)
@done:
}

@meta(Category="Cabin Generator")
@flags(Public, CallInEditor)
entry function RegenerateCabin() {
    %stream = call MakeRandomStream(InitialSeed: $Seed)
    %randomWindow = call RandomIntegerInRangeFromStream(Stream: %stream, Min: 0, Max: 1)
    %automatic = call EqualEqual_IntInt(A: $WindowStyle, B: -1)
    %window = select(Index: %automatic, false: $WindowStyle, true: %randomWindow)
    set LastWindowSelection = %window
    %orientation = switch_int($EntranceOrientation) [0 -> @north, 1 -> @east, 2 -> @south, 3 -> @west, default -> @north]
@north:
    call K2_SetActorRotation(NewRotation: 0,0,0, bTeleportPhysics: true)
    exec -> @build
@east:
    call K2_SetActorRotation(NewRotation: 0,90,0, bTeleportPhysics: true)
    exec -> @build
@south:
    call K2_SetActorRotation(NewRotation: 0,180,0, bTeleportPhysics: true)
    exec -> @build
@west:
    call K2_SetActorRotation(NewRotation: 0,270,0, bTeleportPhysics: true)
@build:
    call ClearCabinModules()
    %layout = switch_int($LayoutVariant) [0 -> @legacy, 1 -> @legacy, 2 -> @square, 3 -> @large, default -> @invalid]
@legacy:
    call GenerateLegacyCabin()
    exec -> @finalize
@square:
    call GenerateSquareCabin()
    exec -> @rooms
@large:
    call GenerateLargeCabin()
@rooms:
    call PlanCabinRooms()
    exec -> @finalize
@invalid:
    set GeneratedModuleCount = 0
    set bValidationPassed = false
    set bWallContinuityValid = false
    set bRoofCoverageValid = false
    set bCollisionClearanceValid = false
    set bExactRepeatValid = false
    set ValidationMessage = "Invalid LayoutVariant. Use 0 Trapper, 1 Long, 2 Square 8x8, or 3 Large 8x12."
    return
@finalize:
    set LastGeneratedSeed = $Seed
    %seedHash = call Multiply_IntInt(A: $Seed, B: 31)
    %layoutHash = call Multiply_IntInt(A: $LayoutVariant, B: 7)
    %hashA = call Add_IntInt(A: %seedHash, B: %layoutHash)
    %orientationHash = call Multiply_IntInt(A: $EntranceOrientation, B: 3)
    %hashB = call Add_IntInt(A: %hashA, B: %orientationHash)
    %hash = call Add_IntInt(A: %hashB, B: %window)
    set GenerationFingerprint = %hash
    set bValidationPassed = false
    set bWallContinuityValid = false
    set bRoofCoverageValid = false
    set bCollisionClearanceValid = false
    set bExactRepeatValid = false
    set ValidationMessage = "Generated deterministically. Structural, room-connectivity and collision validation pending."
}
