entry function Place(object<InstancedStaticMeshComponent> Component, float X, float Y, float Z, float Yaw, float SX, float SY, float SZ) @(0, 0) {
    %n0: struct<Vector> = call MakeVector(X: $X, Y: $Y, Z: $Z) @(312, 64)
    %n1: struct<Rotator> = call MakeRotator(Roll: 0.0, Pitch: 0.0, Yaw: $Yaw) @(240, 248)
    %n2: struct<Vector> = call MakeVector(X: $SX, Y: $SY, Z: $SZ) @(312, 432)
    %n3: struct<Transform> = call MakeTransform(Location: %n0, Rotation: %n1, Scale: %n2) @(520, 64)
    call AddInstance(Target: $Component, InstanceTransform: %n3, bWorldSpace: false) @(768, -16)
    end
}

entry function AddRoom(name Kind, float X, float Y, float Width, float Depth, float DoorX, float DoorY) @(0, 0) {
    %n0: struct<Vector> = call MakeVector(X: $X, Y: $Y, Z: 20) @(248, 204)
    %n1: struct<Vector> = call MakeVector(X: $Width, Y: $Depth, Z: 300) @(240, 388)
    %n2: struct<Vector> = call MakeVector(X: $DoorX, Y: $DoorY, Z: 20) @(248, 572)
    %n3: struct<ST_HouseRoom> = make<ST_HouseRoom>(RoomType_2_87423695486C3E53B2EAF39CEB5A1A7B: $Kind, Min_4_CA1734C84A7EB842FDFAA89748F89847: %n0, Size_6_A050281547D25A85B4448B81EF60035D: %n1, DoorCenter_8_16660F964D81C9BEF3895C9A21215F87: %n2) @(480, 172)
    call Array_Add(TargetArray: $Rooms, NewItem: %n3.ST_HouseRoom) @(768, 20)
    end
}

entry function PlaceOffset(object<InstancedStaticMeshComponent> Component, float X, float Y, float Z, float Yaw, float Along, float Across, float Turn, float SX, float SY, float SZ) @(0, 0) {
    %n0: struct<Vector> = call MakeVector(X: $Along, Y: $Across, Z: 0) @(296, 112)
    %n1: struct<Rotator> = call MakeRotator(Roll: 0.0, Pitch: 0.0, Yaw: $Yaw) @(240, 296)
    %n2: struct<Vector> = call GreaterGreater_VectorRotator(A: %n0, B: %n1) @(520, 112)
    %n3: double = call BreakVector(InVec: %n2) @(728, 112)
    %n4: double = call Add_DoubleDouble(A: $X, B: %n3.X) @(920, 100)
    %n5: double = call Add_DoubleDouble(A: $Y, B: %n3.Y) @(920, 224)
    %n6: double = call Add_DoubleDouble(A: $Yaw, B: $Turn) @(920, 344)
    call Place(Component: $Component, X: %n4, Y: %n5, Z: $Z, Yaw: %n6, SX: $SX, SY: $SY, SZ: $SZ) @(1064, -16)
    end
}

entry function Strip(object<InstancedStaticMeshComponent> Component, float X, float Y, float Z, float Yaw, float Length) @(0, 0) {
    %n0: double = call Divide_DoubleDouble(A: $Length, B: 100) @(-256, 316)
    %n1: int = call FCeil(A: %n0) @(-72, 312)
    %n2: int = call Subtract_IntInt(A: %n1, B: 1) @(136, 324)
    %n3: int = macro ForLoop(FirstIndex: 0, LastIndex: %n2) [Completed -> @completed, LoopBody -> @loopbody] @(304, 120)

@loopbody:
    %n4: double = call Conv_IntToDouble(InInt: %n3.Index) @(368, 32)
    %n5: double = call Multiply_DoubleDouble(A: %n4, B: 100) @(624, 428)
    %n6: double = call Subtract_DoubleDouble(A: $Length, B: %n5) @(808, 412)
    %n7: double = call FMin(A: %n6, B: 100) @(952, 428)
    %n8: double = call Divide_DoubleDouble(A: %n7, B: 100) @(1136, 444)
    call PlaceOffset(Component: $Component, X: $X, Y: $Y, Z: $Z, Yaw: $Yaw, Along: %n5, Across: 0, Turn: 0, SX: %n8, SY: 1, SZ: 1) @(1320, 104)
    end

@completed:
    return @(624, 184)
}

entry function Opening(float X, float Y, float Yaw, float Length, bool ExteriorDoor) @(0, 0) {
    %n0: object<InstancedStaticMeshComponent> = select(Index: $ExteriorDoor, false: $Interior, true: $Exterior) @(440, 64)
    %n1: double = call Divide_DoubleDouble(A: $Length, B: 2) @(272, 304)
    %n2: double = call Subtract_DoubleDouble(A: %n1, B: 150) @(496, 248)
    call Strip(Component: %n0, X: $X, Y: $Y, Z: 20, Yaw: $Yaw, Length: %n2) @(680, -16)
    %n3: object<InstancedStaticMeshComponent> = select(Index: $ExteriorDoor, false: $Doorway, true: $Entrance) @(1200, 64)
    call PlaceOffset(Component: %n3, X: $X, Y: $Y, Z: 20, Yaw: $Yaw, Along: %n2, Across: 0, Turn: 0, SX: 1, SY: 1, SZ: 1) @(1440, -16)
    %n4: double = call Add_DoubleDouble(A: %n1, B: 150) @(1768, 116)
    %n5: struct<Vector> = call MakeVector(X: %n4, Y: 0, Z: 0) @(2008, 112)
    %n6: struct<Rotator> = call MakeRotator(Roll: 0.0, Pitch: 0.0, Yaw: $Yaw) @(1952, 296)
    %n7: struct<Vector> = call GreaterGreater_VectorRotator(A: %n5, B: %n6) @(2232, 112)
    %n8: double = call BreakVector(InVec: %n7) @(2440, 112)
    %n9: double = call Add_DoubleDouble(A: $X, B: %n8.X) @(2632, 100)
    %n10: double = call Add_DoubleDouble(A: $Y, B: %n8.Y) @(2632, 224)
    call Strip(Component: %n0, X: %n9, Y: %n10, Z: 20, Yaw: $Yaw, Length: %n2) @(2776, -16)
    %n11: double = call Subtract_DoubleDouble(A: %n1, B: 50) @(3120, 228)
    call PlaceOffset(Component: $DoorFrame, X: $X, Y: $Y, Z: 20, Yaw: $Yaw, Along: %n11, Across: 10, Turn: 0, SX: 1, SY: 1, SZ: 1) @(3296, -16)
    %n12 = branch($ShowOpenDoors) [false -> @else, true -> @then] @(3848, 0)

@then:
    call PlaceOffset(Component: $DoorLeaf, X: $X, Y: $Y, Z: 20, Yaw: $Yaw, Along: %n11, Across: 10, Turn: -90, SX: 1, SY: 1, SZ: 1) @(4296, -16)
    end

@else:
    return @(4104, 184)
}

entry function Facade(float X, float Y, float Yaw, float Length) @(0, 0) {
