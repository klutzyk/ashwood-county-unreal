entry function PlaceCabinModule(object<InstancedStaticMeshComponent> Component, float X, float Y, float Z, float Yaw, float SX, float SY, float SZ) {
    %location = call MakeVector(X: $X, Y: $Y, Z: $Z)
    %rotation = call MakeRotator(Roll: 0.0, Pitch: 0.0, Yaw: $Yaw)
    %scale = call MakeVector(X: $SX, Y: $SY, Z: $SZ)
    %transform = call MakeTransform(Location: %location, Rotation: %rotation, Scale: %scale)
    call AddInstance(Target: $Component, InstanceTransform: %transform, bWorldSpace: false)
}

entry function AddCabinRoom(string Kind, float MinX, float MinY, float MaxX, float MaxY, float DoorX, float DoorY) {
    %min = call MakeVector(X: $MinX, Y: $MinY, Z: 0)
    %max = call MakeVector(X: $MaxX, Y: $MaxY, Z: 280)
    %door = call MakeVector(X: $DoorX, Y: $DoorY, Z: 0)
    %room = make<ST_ACCabinRoom>(RoomType_2_7308358E443836EBB5F4ECA93B132204: $Kind, BoundsMin_4_7A2F6EF64A7318F1B45F30A793FADD54: %min, BoundsMax_6_50B94C3547C460B61DE033827624934A: %max, DoorwayAnchor_8_219CF2DB409964A5C66B4091E7B0C0D5: %door)
    call Array_Add(TargetArray: $GeneratedRooms, NewItem: %room)
}

entry function ClearCabinModules() {
    call ClearInstances(Target: $FloorISM)
    call ClearInstances(Target: $FoundationISM)
    call ClearInstances(Target: $WallSolidISM)
    call ClearInstances(Target: $WallLongISM)
    call ClearInstances(Target: $DoorWallISM)
    call ClearInstances(Target: $WindowWallISM)
    call ClearInstances(Target: $WindowDoubleWallISM)
    call ClearInstances(Target: $GableISM)
    call ClearInstances(Target: $GableDoorISM)
    call ClearInstances(Target: $GableWindowISM)
    call ClearInstances(Target: $GableWindowDoubleISM)
    call ClearInstances(Target: $PillarISM)
    call ClearInstances(Target: $RoofISM)
    call ClearInstances(Target: $RoofBothISM)
    call ClearInstances(Target: $RoofEndLeftISM)
    call ClearInstances(Target: $RoofEndRightISM)
    call ClearInstances(Target: $PorchRoofISM)
    call ClearInstances(Target: $PartitionWall200ISM)
    call ClearInstances(Target: $PartitionWall100ISM)
    call ClearInstances(Target: $PartitionDoorwayISM)
    call ClearInstances(Target: $PartitionTrimISM)
    call Array_Clear(TargetArray: $GeneratedRooms)
}

entry function PlaceSelectedWindow(float X, float Y, float Yaw) {
    %useDouble = call EqualEqual_IntInt(A: $LastWindowSelection, B: 1)
    branch(%useDouble) [true -> @double, false -> @single]
@double:
    call PlaceCabinModule(Component: $WindowDoubleWallISM, X: $X, Y: $Y, Z: 0, Yaw: $Yaw, SX: 1, SY: 1, SZ: 1)
    return
@single:
    call PlaceCabinModule(Component: $WindowWallISM, X: $X, Y: $Y, Z: 0, Yaw: $Yaw, SX: 1, SY: 1, SZ: 1)
}

entry function PlaceSelectedGableWindow(float X, float Y, float Yaw, float WidthScale) {
    %useDouble = call EqualEqual_IntInt(A: $LastWindowSelection, B: 1)
    branch(%useDouble) [true -> @double, false -> @single]
@double:
    call PlaceCabinModule(Component: $GableWindowDoubleISM, X: $X, Y: $Y, Z: 0, Yaw: $Yaw, SX: 1, SY: $WidthScale, SZ: 1)
    return
@single:
    call PlaceCabinModule(Component: $GableWindowISM, X: $X, Y: $Y, Z: 0, Yaw: $Yaw, SX: 1, SY: $WidthScale, SZ: 1)
}

