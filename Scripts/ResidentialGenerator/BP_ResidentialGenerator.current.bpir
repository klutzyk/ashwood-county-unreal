    %n14: double = call Add_DoubleDouble(A: $Y, B: %n12.Y) @(1536, 1464)
    %n15: double = call Subtract_DoubleDouble(A: $Length, B: %n8) @(1536, 1584)
    call Strip(Component: $Exterior, X: %n13, Y: %n14, Z: 20, Yaw: $Yaw, Length: %n15) @(1680, 1144)
    end

@then:
    %n16: double = call Conv_IntToDouble(InInt: %n3.Index) @(368, 32)
    %n17: double = call Multiply_DoubleDouble(A: %n16, B: 300) @(1464, 348)
    call PlaceOffset(Component: $Window, X: $X, Y: $Y, Z: 20, Yaw: $Yaw, Along: %n17, Across: 0, Turn: 0, SX: 1, SY: 1, SZ: 1) @(1648, 104)
    call PlaceOffset(Component: $Frame, X: $X, Y: $Y, Z: 20, Yaw: $Yaw, Along: %n17, Across: 0, Turn: 0, SX: 1, SY: 1, SZ: 1) @(2168, 104)
    call PlaceOffset(Component: $Glass, X: $X, Y: $Y, Z: 20, Yaw: $Yaw, Along: %n17, Across: 0, Turn: 0, SX: 1, SY: 1, SZ: 1) @(2688, 104)
    end

@else:
