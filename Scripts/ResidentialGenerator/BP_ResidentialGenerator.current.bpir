    call TransactObject(Object: $DoorFrame) @(8592, 0)
    call ClearInstances(Target: $DoorFrame) @(8832, -16)
    call TransactObject(Object: $DoorLeaf) @(9408, 0)
    call ClearInstances(Target: $DoorLeaf) @(9648, -16)
    call TransactObject(Object: $RoofPanel) @(10224, 0)
    call ClearInstances(Target: $RoofPanel) @(10464, -16)
    call TransactObject(Object: $RoofCorner) @(11040, 0)
    call ClearInstances(Target: $RoofCorner) @(11280, -16)
    call TransactObject(Object: $Foundation) @(11856, 0)
    call ClearInstances(Target: $Foundation) @(12096, -16)
    end
}

entry function ChooseRoomDepth(int Low, int High, name Kind) -> int @(0, 0) {
    %n0: bool = call EqualEqual_NameName(A: $Kind, B: "Bathroom") @(240, 56)
    %n1 = branch(%n0) [false -> @else, true -> @then] @(456, 0)

@then:
    %n2: int = call Add_IntInt(A: $Low, B: $High) @(712, 84)
    %n3: int = call Divide_IntInt(A: %n2, B: 2) @(856, 100)
    %n4: int = call DrawInt(Low: $Low, High: %n3) @(1024, -16)
    return %n4 @(1352, 0)

@else:
    %n5: bool = call EqualEqual_NameName(A: $Kind, B: "Bedroom") @(712, 288)
    %n6 = branch(%n5) [false -> @else_2, true -> @then_2] @(928, 232)

@then_2:
    %n7: int = call DrawInt(Low: $Low, High: $High) @(1184, 216)
    return %n7 @(1512, 232)

@else_2:
    %n8: int = call DrawInt(Low: %n3, High: $High) @(1184, 448)
    return %n8 @(1512, 464)
}

entry function DrawInt(int Low, int High) -> int @(0, 0) {
    %n0: int = call RandomIntegerInRangeFromStream(Stream: $Stream, Min: $Low, Max: $High) @(432, 56)
    return %n0 @(736, 0)
}

entry function PickRoomType(bool LeftWing, int Index) -> name @(0, 0) {
    %n0: bool = call EqualEqual_IntInt(A: $RoomCount, B: 3) @(432, 56)
    %n1 = branch(%n0) [false -> @else, true -> @then] @(600, 0)

@then:
    %n2: bool = call EqualEqual_IntInt(A: $PlanLeftCount, B: 1) @(1064, 72)
    %n3: bool = call EqualEqual_BoolBool(A: $LeftWing, B: %n2) @(1232, 56)
    %n4 = branch(%n3) [false -> @else_2, true -> @then_2] @(1376, 0)

@else:
    %n5: bool = call EqualEqual_IntInt(A: $Index, B: 0) @(856, 400)
    %n6 = branch(%n5) [false -> @else_3, true -> @then_3] @(1024, 344)

@then_2:
    return "LivingKitchen" @(1632, 0)

@else_2:
    %n7: bool = call EqualEqual_IntInt(A: $Index, B: 0) @(1632, 220)
    %n8: name = select(Index: %n7, false: "Bathroom", true: "Bedroom") @(1800, 152)
    return %n8 @(2112, 32)

@then_3:
    %n9: name = select(Index: $LeftWing, false: "Kitchen", true: "Living") @(1280, 400)
    return %n9 @(1584, 344)

@else_3:
    %n10: bool = call Greater_IntInt(A: $PlanRightCount, B: 1) @(1496, 604)
    %n11: bool = call NotEqual_BoolBool(A: $LeftWing, B: %n10) @(1688, 588)
    %n12: bool = call EqualEqual_IntInt(A: $Index, B: 1) @(1664, 712)
    %n13: bool = call BooleanAND(A: %n11, B: %n12) @(1832, 604)
    %n14: name = select(Index: %n13, false: "Bedroom", true: "Bathroom") @(1976, 536)
    return %n14 @(2288, 376)
}

entry function AddPlannedRoom(name Kind, float X, float Y, float Width, float Depth, float DoorX, float DoorY) @(0, 0) {
    %n0: struct<Vector> = call MakeVector(X: $X, Y: $Y, Z: 20) @(248, 204)
    %n1: struct<Vector> = call MakeVector(X: $Width, Y: $Depth, Z: 300) @(240, 388)
    %n2: struct<Vector> = call MakeVector(X: $DoorX, Y: $DoorY, Z: 20) @(248, 572)
    %n3: struct<ST_HouseRoom> = make<ST_HouseRoom>(RoomType_2_87423695486C3E53B2EAF39CEB5A1A7B: $Kind, Min_4_CA1734C84A7EB842FDFAA89748F89847: %n0, Size_6_A050281547D25A85B4448B81EF60035D: %n1, DoorCenter_8_16660F964D81C9BEF3895C9A21215F87: %n2) @(480, 172)
    call Array_Add(TargetArray: $PendingRooms, NewItem: %n3.ST_HouseRoom) @(768, 20)
    end
}

entry function PlanWing(bool LeftWing, int Count) @(0, 0) {
    %n0: int = call Multiply_IntInt(A: $LengthMetres, B: 2) @(448, 248)
    set PlanRemainingUnits = %n0 @(616, 192)
    set PlanCursorUnits = 0 @(976, 192)
    %n1: int = call Subtract_IntInt(A: $Count, B: 1) @(1032, 68)
    %n2: int = macro ForLoop(FirstIndex: 0, LastIndex: %n1) [Completed -> @completed, LoopBody -> @loopbody] @(1200, 0)

@loopbody:
    %n3: name = call PickRoomType(LeftWing: $LeftWing, Index: %n2.Index) @(1520, -16)
    %n4: int = call Subtract_IntInt(A: %n1, B: %n2.Index) @(1912, 232)
    %n5: int = call Multiply_IntInt(A: %n4, B: $PlanMaxUnits) @(2160, 100)
    %n6: int = call Subtract_IntInt(A: $PlanRemainingUnits, B: %n5) @(2304, 84)
    %n7: int = call Max(A: $PlanMinUnits, B: %n6) @(2448, 68)
    %n8: int = call Multiply_IntInt(A: %n4, B: $PlanMinUnits) @(2160, 344)
    %n9: int = call Subtract_IntInt(A: $PlanRemainingUnits, B: %n8) @(2304, 208)
    %n10: int = call Min(A: $PlanMaxUnits, B: %n9) @(2448, 192)
    %n11: int = call ChooseRoomDepth(Low: %n7, High: %n10, Kind: %n3) @(2592, -16)
    set PlanPickedUnits = %n11 @(2920, 0)
    %n12: double = call Conv_IntToDouble(InInt: $PlanLeftWidthUnits) @(1344, 336)
    %n13: double = call Multiply_DoubleDouble(A: %n12, B: 50) @(3440, 376)
    %n14: double = call Add_DoubleDouble(A: %n13, B: 200) @(3648, 392)
    %n15: double = select(Index: $LeftWing, false: %n14, true: 0.0) @(4072, 96)
    %n16: double = call Conv_IntToDouble(InInt: $PlanCursorUnits) @(1344, 848)
    %n17: double = call Multiply_DoubleDouble(A: %n16, B: 50) @(3256, 752)
    %n18: double = call Conv_IntToDouble(InInt: $LengthMetres) @(1344, 592)
    %n19: double = call Multiply_DoubleDouble(A: %n18, B: 100) @(3432, 648)
    %n20: double = call Conv_IntToDouble(InInt: $PlanPickedUnits) @(1344, 976)
    %n21: double = call Multiply_DoubleDouble(A: %n20, B: 50) @(3256, 872)
    %n22: double = call Add_DoubleDouble(A: %n17, B: %n21) @(3472, 768)
    %n23: double = call Subtract_DoubleDouble(A: %n19, B: %n22) @(3688, 664)
    %n24: double = select(Index: $EntranceAtRear, false: %n17, true: %n23) @(3832, 628)
    %n25: double = call Conv_IntToDouble(InInt: $WidthMetres) @(1344, 528)
    %n26: double = call Multiply_DoubleDouble(A: %n25, B: 100) @(3648, 268)
    %n27: double = call Subtract_DoubleDouble(A: %n26, B: %n14) @(3928, 284)
    %n28: double = select(Index: $LeftWing, false: %n27, true: %n13) @(4112, 280)
    %n29: double = select(Index: $LeftWing, false: %n14, true: %n13) @(4112, 464)
    %n30: double = call Divide_DoubleDouble(A: %n21, B: 2) @(3904, 816)
    %n31: double = call Add_DoubleDouble(A: %n24, B: %n30) @(4208, 648)
    call AddPlannedRoom(Kind: %n3, X: %n15, Y: %n24, Width: %n28, Depth: %n21, DoorX: %n29, DoorY: %n31) @(4352, -16)
    %n32: int = call Subtract_IntInt(A: $PlanRemainingUnits, B: $PlanPickedUnits) @(4904, 56)
    set PlanRemainingUnits = %n32 @(5048, 0)
    %n33: int = call Add_IntInt(A: $PlanCursorUnits, B: $PlanPickedUnits) @(5632, 56)
    set PlanCursorUnits = %n33 @(5776, 0)
    end

@completed:
    return @(1520, 216)
}
